# /etc/protocol/protocol.env — o ambiente do servidor em produção.
#
# COPIE, PREENCHA NA MÁQUINA, E NÃO DEVOLVA AO REPOSITÓRIO. Este arquivo de
# exemplo não tem segredo nenhum; o de verdade tem três (o segredo do portão,
# a senha do banco dentro da URL, e a senha do SMTP) e mora só no servidor:
#
#     sudo install -m 600 -o protocol -g protocol protocol.env.exemplo /etc/protocol/protocol.env
#
# `tests/testes_repositorio.py` confere que toda variável que o servidor lê
# está aqui, e que nada aqui é um nome que o servidor não lê.

# --- obrigatórias: sem elas o servidor não sobe, ou não atende ninguém ------

# Assina código de acesso, sessão e o marcador de CPF. Gere NA MÁQUINA:
#     python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
# Trocar depois invalida as sessões abertas E os marcadores de quem foi
# apagado a pedido — a reingestão deixaria de reconhecê-los. Não troque.
PROTOCOL_SEGREDO=

# Onde moram os dados. O DIÁRIO de cadastros fica aqui, e ele é a autoridade:
# é esta pasta que o backup tem de levar.
PROTOCOL_RAIZ=/var/lib/protocol

# O banco. Com a senha na URL — por isso o arquivo é 600.
PROTOCOL_DATABASE_URL=

# Onde o banco está. Entidade real só é atendida em região brasileira.
PROTOCOL_REGIAO=sa-east-1

# O endereço do portal, como o navegador o vê. Mais de um, separe por vírgula.
PROTOCOL_ORIGENS=https://portal.exemplo.org

# O envio do código de acesso. Sem HOST e REMETENTE o servidor não sobe.
PROTOCOL_SMTP_HOST=
PROTOCOL_SMTP_PORTA=587
PROTOCOL_SMTP_USUARIO=
PROTOCOL_SMTP_SENHA=
PROTOCOL_SMTP_REMETENTE=

# --- de quem opera -----------------------------------------------------------

# Para onde vai o aviso de pedido esperando (troca de e-mail, entrada segurada).
# Vazio, a tarefa `pedidos` falha enquanto houver pedido, e aparece em /saude.
PROTOCOL_EMAIL_DE_QUEM_OPERA=

# O Caddy desta pasta fica na frente do servidor, na mesma máquina. Sem esta
# linha o limite de pedidos de código conta TODOS os filiados como um só.
PROTOCOL_PROXIES_CONFIAVEIS=127.0.0.1

# O endereço que o e-mail de aviso de movimentação mostra. Vazio, o e-mail
# não inventa link.
PROTOCOL_PORTAL=https://portal.exemplo.org

# O trabalho de fundo (coletar, avisar, reavaliar, pedidos). 1 liga.
PROTOCOL_AGENDAR=1

# Limites de pedido de código por hora. Suba o segundo se o sindicato atende
# vários filiados do mesmo computador da sede.
PROTOCOL_EMISSOES_POR_CPF_HORA=3
PROTOCOL_EMISSOES_POR_ORIGEM_HORA=20

# A pasta do portal compilado, para o SERVIDOR entregar as páginas no mesmo
# endereço da API (um serviço só). Com o Caddy desta pasta fica VAZIO: é ele
# que entrega as páginas.
PROTOCOL_PORTAL_ESTATICO=

# --- NUNCA em produção -------------------------------------------------------
# PROTOCOL_MODO_ENSAIO=1   devolve o código de acesso na resposta HTTP
# PROTOCOL_SEMENTE_DEMO=1  cria um sindicato de demonstração na subida
